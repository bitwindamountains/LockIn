{
  "manifest_version": 3,
  "name": "LockIn — Browser alpha",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Local study sessions, selected website rules and configurable YouTube hashtag access.",
  "permissions": ["storage", "alarms", "nativeMessaging", "declarativeNetRequestWithHostAccess", "scripting", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "web_accessible_resources": [{ "resources": ["blocked.html", "focus.html", "page.js", "popup.css"], "matches": ["<all_urls>"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
