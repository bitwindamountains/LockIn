<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="CanvasBrush" Color="#F7F7F0"/><SolidColorBrush x:Key="InkBrush" Color="#20392C"/>
 <SolidColorBrush x:Key="MutedBrush" Color="#586657"/><SolidColorBrush x:Key="LineBrush" Color="#D4D9CD"/>
 <Thickness x:Key="SectionSpacing">0,16,0,0</Thickness>
 <Thickness x:Key="ControlPadding">12,10</Thickness>
 <CornerRadius x:Key="ControlRadius">8</CornerRadius>
 <Style x:Key="SupportingText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
 <Style x:Key="SectionPanel" TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="0,20"/></Style>
 <Style TargetType="Expander"><Setter Property="Margin" Value="{StaticResource SectionSpacing}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
  <ToggleButton x:Name="Disclosure" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" MinHeight="44" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" FocusVisualStyle="{DynamicResource FocusRing}">
   <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="4,8"><DockPanel><TextBlock x:Name="Indicator" Text="+" Width="24" FontSize="18" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center" ContentSource="Content"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Indicator" Property="Text" Value="−"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E9EDE2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
  </ToggleButton><ContentPresenter x:Name="Details" Visibility="Collapsed" Margin="4,8,4,0"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="SurfaceCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="24"/></Style>
 <Style x:Key="FocusRing" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="#175ACA" BorderThickness="3" CornerRadius="{StaticResource ControlRadius}" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Button">
  <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,4,8,4"/>
  <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#20392C"/><Setter Property="BorderBrush" Value="#82917B"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#254B36"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="#254B36"/></Style>
 <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="{StaticResource ControlPadding}"/><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#82917B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,8,0,16"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#82917B"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton x:Name="DropButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="White" BorderBrush="#82917B" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#586657"/></Border></ControlTemplate></ToggleButton.Template>
   </ToggleButton>
   <ContentPresenter x:Name="Selection" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,8,38,8" VerticalAlignment="Center" IsHitTestVisible="False"/>
   <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Style="{x:Null}" Background="Transparent" BorderThickness="0" Margin="12,8,38,8" VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}"/>
   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
    <Border Background="White" BorderBrush="#82917B" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
   </Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="CheckBox"><Setter Property="MinHeight" Value="44"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/></Style>
 <Style TargetType="TabItem"><Setter Property="Foreground" Value="#586657"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Nav" Padding="14,13" Margin="2" CornerRadius="{StaticResource ControlRadius}" Background="Transparent"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#E1EBBD"/><Setter Property="Foreground" Value="#203A2D"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Sections" TargetType="TabControl"><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel><WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,16"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></DockPanel></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="Shell" TargetType="TabControl"><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Foreground" Value="#D8E3D5"/></Style></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailWidth" Width="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="TopRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="Rail" Grid.RowSpan="2" Background="#203A2D"><DockPanel x:Name="RailContent" Margin="16,28,16,20">
    <StackPanel x:Name="Brand" DockPanel.Dock="Top" Margin="8,0,0,24"><StackPanel Orientation="Horizontal"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Border Width="4" Height="27" CornerRadius="2" Background="#DCE8B4"/><Border Width="4" Height="16" Margin="3,0" CornerRadius="2" Background="#DCE8B4"/><Border Width="4" Height="22" CornerRadius="2" Background="#DCE8B4"/></StackPanel><TextBlock Text="LockIn" FontSize="27" FontWeight="SemiBold" Foreground="#F0F1E8"/></StackPanel><TextBlock Text="Your study space" Foreground="#D0DAC9" FontSize="12" Margin="0,8,0,0"/></StackPanel>
    <TextBlock x:Name="RailNote" DockPanel.Dock="Bottom" Text="LOCAL · BROWSER ALPHA" Foreground="#D0DAC9" FontSize="10" Margin="8,24,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="Navigation" Orientation="Vertical" IsItemsHost="True"/></ScrollViewer>
   </DockPanel></Border>
   <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" Grid.Row="1" ContentSource="SelectedContent" Margin="32,24"/>
   </Grid><ControlTemplate.Triggers><Trigger Property="Tag" Value="short"><Setter TargetName="RailNote" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Tag" Value="compact"><Setter TargetName="RailContent" Property="Margin" Value="10,8"/><Setter TargetName="RailWidth" Property="Width" Value="0"/><Setter TargetName="TopRow" Property="Height" Value="Auto"/><Setter TargetName="Rail" Property="Grid.ColumnSpan" Value="2"/><Setter TargetName="Rail" Property="Grid.RowSpan" Value="1"/><Setter TargetName="Brand" Property="Visibility" Value="Collapsed"/><Setter TargetName="RailNote" Property="Visibility" Value="Collapsed"/><Setter TargetName="Navigation" Property="Orientation" Value="Horizontal"/><Setter TargetName="PART_SelectedContentHost" Property="Margin" Value="18"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Error" TargetType="TextBlock"><Setter Property="Foreground" Value="#A02B20"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,8"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
 <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="28"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
</ResourceDictionary>
